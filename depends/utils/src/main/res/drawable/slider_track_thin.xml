<?xml version="1.0" encoding="utf-8"?>
<!-- Thinner counterpart of slider_track.xml, paired with slider_thumb_small.xml for tight,
     fixed-height rows. See slider_track.xml for why only the background layer is rounded. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="?attr/colorControlNormal" />
            <size android:height="6dp" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
