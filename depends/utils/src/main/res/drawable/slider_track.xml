<?xml version="1.0" encoding="utf-8"?>
<!-- A thicker, solid-color SeekBar track in place of the plain thin flat line the platform default
     progressDrawable draws, with a rounded-pill outline. Only the background layer (item below) is
     rounded: it's drawn at its own fixed, full-width bounds, never clipped, so rounding it is safe.
     The progress/secondaryProgress layers stay flat-edged rectangles: rounding a shape that
     ClipDrawable then clips to a moving width turned out to render an odd bump on some devices
     right where the clip boundary falls, under the thumb, so those two are left square. The
     background is theme-aware so it stays legible on both light and dark app themes; the
     progress/secondaryProgress segments are plain white so that
     android:progressTint/secondaryProgressTint (set per-style) recolor them. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="?attr/colorControlNormal" />
            <size android:height="6dp" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
