<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Classic">

        <item name="android:colorBackground">#182532</item>

        <!-- Status bar-->
        <item name="colorPrimaryDark">#304D70</item>

        <!-- Tool/Nav bars -->
        <item name="colorPrimary">#121E29</item>
        <item name="colorOnPrimary">#a1a5a9</item>
        <item name="android:textColorPrimary">#a1a5a9</item>

        <!-- List/Media items -->
        <item name="colorSecondary">#243447</item>
        <!-- Was #095381, a dark saturated blue that barely stood out against this dark navy
        colorSecondary. Matches colorOnPrimary (the nav-bar icon color) instead, for icons drawn
        on list/media item and preference cards to actually read against them. -->
        <item name="colorOnSecondary">#a1a5a9</item>
        <item name="android:textColorSecondary">#bec2c8</item>

        <!-- Active media item -->
        <item name="alpha">0.7</item>
        <item name="colorSecondaryVariant">#2C486A</item>
        <item name="android:textColorTertiary">#ffffff</item>

        <!-- Popup menu -->
        <item name="colorSurface">#182532</item>
        <item name="colorOnSurface">#095381</item>
        <item name="colorPrimarySurface">#27394A</item>
        <item name="colorOnPrimarySurface">#095381</item>

        <item name="colorAccent">#4B78AF</item>
        <item name="rippleColor">#83A5CF</item>

        <item name="android:textColorHint">#0F0F0F</item>

        <item name="colorControlNormal">#999CA1</item>
        <!-- Was #095381, the same low-contrast dark blue as colorOnSecondary above; checkboxes
        and sliders tinted with it were nearly invisible against colorSecondary. Reuses the
        theme's own brighter accent instead. -->
        <item name="colorControlActivated">#4B78AF</item>

        <!-- Material 3 roles -->
        <item name="colorSurfaceVariant">#27394A</item>
        <item name="colorOnSurfaceVariant">#bec2c8</item>
        <item name="colorOutline">#4B78AF</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>

    </style>

</resources>
